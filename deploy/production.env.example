# Copy to .env.production and fill every value. Never commit .env.production.
# The container paths for DATABASE_PATH, UPLOAD_DIR and PRIVATE_DOCS_DIR are
# set by compose.yaml and must not be overridden here.

NODE_ENV=production
PORT=8787
APP_URL=https://www.dearhills.in
TRUST_PROXY=1
ALLOWED_ORIGINS=

SESSION_DAYS=30
SESSION_IDLE_DAYS=7
SESSION_COOKIE_SAMESITE=lax

SEED_ON_START=false
ALLOW_DEV_PAYMENTS=false
ALLOW_DEV_AUTH_HELPERS=false

# Public Google OAuth Web client ID. No client secret is used by this flow.
GOOGLE_CLIENT_ID=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=PAHADI ROOTS <no-reply@dearhills.in>
SUPPORT_EMAIL=support@dearhills.in

LOG_LEVEL=info
