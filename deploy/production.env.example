# Copy to .env.production and fill every value. Never commit .env.production.
# The container paths for DATABASE_PATH, UPLOAD_DIR and PRIVATE_DOCS_DIR are
# set by compose.yaml and must not be overridden here.

NODE_ENV=production
PORT=8787
APP_URL=https://www.dearhills.in
TRUST_PROXY=1
ALLOWED_ORIGINS=

SESSION_DAYS=30
SESSION_IDLE_DAYS=7
SESSION_COOKIE_SAMESITE=lax

SEED_ON_START=false
ALLOW_DEV_PAYMENTS=false
ALLOW_DEV_AUTH_HELPERS=false

# Public Google OAuth Web client ID. No client secret is used by this flow.
GOOGLE_CLIENT_ID=

# Payment-gateway integration is out of scope for this build. Leave these empty
# unless a separately scoped and verified integration is being deployed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Preferred transactional email provider. Create a fresh key for this host.
RESEND_API_KEY=
EMAIL_TIMEOUT_MS=10000
EMAIL_MAX_ATTEMPTS=3
EMAIL_FROM=PAHADI ROOTS <no-reply@dearhills.in>
SUPPORT_EMAIL=support@dearhills.in
ADMIN_NOTIFICATION_EMAIL=support@dearhills.in

# Optional SMTP fallback. Resend wins when RESEND_API_KEY is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

LOG_LEVEL=info
