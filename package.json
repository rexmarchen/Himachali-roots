{
  "name": "pahadi-roots",
  "private": true,
  "version": "0.1.0",
  "description": "PAHADI ROOTS — a curated multi-vendor marketplace for authentic Himachali products.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "node scripts/build-web.mjs",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-server-assets.mjs",
    "start": "node dist-server/server/index.js",
    "seed": "tsx server/seed.ts",
    "reset": "tsx server/seed.ts --reset",
    "db:backup": "node scripts/backup-db.mjs",
    "db:verify": "node scripts/verify-backup.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "admin:create": "tsx server/scripts/create-admin.ts"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tanstack/react-query": "^5.90.5",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.2.1",
    "razorpay": "^2.9.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@tailwindcss/vite": "^4.1.16",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.9.1",
    "@types/nodemailer": "^7.0.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.4.0",
    "sharp": "^0.35.5",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  }
}
