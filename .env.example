# PAHADI ROOTS — environment template
# Copy to .env for local development. Never commit real secrets.

NODE_ENV=development
PORT=8787
APP_URL=http://localhost:5173

# SQLite file. Use an absolute path in production, on a persistent volume.
DATABASE_PATH=./data/pahadi-roots.db
UPLOAD_DIR=./storage/uploads

# Seed demonstration data on first start (non-production only).
SEED_ON_START=true

# Password for the demo seller accounts created by the seed. Change or unset
# this if you expose a development instance beyond your own machine.
DEMO_SEED_PASSWORD=PahadiDemo!2026

# Development-only shortcuts. Both are forcibly disabled when NODE_ENV=production.
# ALLOW_DEV_PAYMENTS and SIMULATED_CHECKOUT_ENABLED let a customer complete a simulated demo checkout
# and mark an order paid through /api/dev/orders/:orderNumber/pay. They must never be enabled in production.
ALLOW_DEV_PAYMENTS=true
SIMULATED_CHECKOUT_ENABLED=true
# Enables development helpers such as returning verification/reset links in API
# responses when email is not configured. Never enable in production.
ALLOW_DEV_AUTH_HELPERS=true

# Behind a reverse proxy (Caddy/Nginx/Cloudflare) set this to 1 so rate limits
# and secure-cookie detection see the real client IP.
TRUST_PROXY=0

SESSION_DAYS=30
RESERVATION_MINUTES=30
DEFAULT_COMMISSION_BP=1500
FLAT_SHIPPING_PAISE=7900
FREE_SHIPPING_THRESHOLD_PAISE=149900

# Razorpay (test keys start rzp_test_). Leave blank to disable live checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret configured in the Razorpay dashboard. Required for /api/webhooks/razorpay.
RAZORPAY_WEBHOOK_SECRET=

# Transactional email. Without SMTP, notifications are recorded with status
# "skipped" and nothing is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=PAHADI ROOTS <no-reply@pahadiroots.example>
SUPPORT_EMAIL=hello@pahadiroots.example

# Shiprocket is intentionally not implemented. Dispatch is manual; these values
# are reserved for a future adapter and do not enable anything today.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=

LOG_LEVEL=info
SENTRY_DSN=
