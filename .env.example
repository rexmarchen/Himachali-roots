# PAHADI ROOTS — environment template
# Copy to .env for local development. Never commit real secrets.

NODE_ENV=development
PORT=8787
# Public origin of the site, no trailing slash. Must be https:// in production.
# Production for this project: https://www.dearhills.in
APP_URL=http://localhost:5173

# Extra browser origins allowed to call the API with cookies, comma separated.
# Only needed when the SPA and API are on different sites. Same-origin needs none.
ALLOWED_ORIGINS=

# Optional build-time API origin for a split deployment. Leave unset for /api.
# When set, ALLOWED_ORIGINS, HTTPS and SESSION_COOKIE_SAMESITE=none are required.
VITE_API_BASE_URL=

# SQLite file. Use an absolute path in production, on a persistent volume.
DATABASE_PATH=./data/pahadi-roots.db
UPLOAD_DIR=./storage/uploads
# Private seller/KYC documents. Never served publicly; back this up with the database.
PRIVATE_DOCS_DIR=./storage/private/seller-docs

# Seed demonstration data on first start (non-production only).
SEED_ON_START=true

# Password for the demo seller accounts created by the seed. Change or unset
# this if you expose a development instance beyond your own machine.
DEMO_SEED_PASSWORD=PahadiDemo!2026

# Development-only shortcuts. Both are forcibly disabled when NODE_ENV=production.
# ALLOW_DEV_PAYMENTS and SIMULATED_CHECKOUT_ENABLED let a customer complete a simulated demo checkout
# and mark an order paid through /api/dev/orders/:orderNumber/pay. They must never be enabled in production.
ALLOW_DEV_PAYMENTS=true
SIMULATED_CHECKOUT_ENABLED=true
# Enables development helpers such as returning verification/reset links in API
# responses when email is not configured. Never enable in production.
ALLOW_DEV_AUTH_HELPERS=true

# Behind a reverse proxy (Caddy/Nginx/Cloudflare) set this to 1 so rate limits
# and secure-cookie detection see the real client IP.
TRUST_PROXY=0

SESSION_DAYS=30
# A session also expires after this many days without activity. Must be <= SESSION_DAYS.
SESSION_IDLE_DAYS=7
# lax (default, same-site), strict, or none (cross-site only, requires HTTPS).
SESSION_COOKIE_SAMESITE=lax
RESERVATION_MINUTES=30
DEFAULT_COMMISSION_BP=1500
FLAT_SHIPPING_PAISE=7900
FREE_SHIPPING_THRESHOLD_PAISE=149900

# Google Identity Services sign-in. Create an OAuth 2.0 Web application client
# in Google Cloud Console. The server verifies the browser ID token against
# this audience. No client secret is used or required for this flow.
GOOGLE_CLIENT_ID=

# Razorpay (test keys start rzp_test_). Leave blank to disable live checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret configured in the Razorpay dashboard. Required for /api/webhooks/razorpay.
RAZORPAY_WEBHOOK_SECRET=

# Transactional email. Resend is the recommended provider in production; SMTP
# remains supported as a fallback. Without either, notifications are recorded
# with status "skipped" and nothing is sent.
# Create a fresh Resend key for this deployment. Never reuse a key that has been
# pasted into chat, docs or source control.
RESEND_API_KEY=
EMAIL_TIMEOUT_MS=10000
EMAIL_MAX_ATTEMPTS=3
# Must be a verified sending domain in Resend (or a valid SMTP From address).
EMAIL_FROM=PAHADI ROOTS <no-reply@pahadiroots.example>
SUPPORT_EMAIL=hello@pahadiroots.example
# Real monitored inbox for return/refund/deletion alerts.
ADMIN_NOTIFICATION_EMAIL=hello@pahadiroots.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Shiprocket is intentionally not implemented. Dispatch is manual; these values
# are reserved for a future adapter and do not enable anything today.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=

LOG_LEVEL=info
SENTRY_DSN=
